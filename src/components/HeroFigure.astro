---
/**
 * HeroFigure — the hero's right column: frame-by-frame animation from video.
 *
 * Extracts frames from the video (36 fps, ~10s = 360 frames) and plays them
 * as a CSS animation. Keeps the same parallax drift and scroll-lift behaviour
 * via CSS custom properties.
 *
 * Three states:
 *   1. Driven: frame animation + parallax drift + scroll lift (fine pointer, no reduced motion)
 *   2. Static: frame animation only (touch/no-JS)
 *   3. Poster: first frame only (reduced motion)
 *
 * Lazy-loaded with skeleton placeholder.
 */

import { studio } from '~/config/site';

// Import all frame images - Vite will optimize them
const frameModules = import.meta.glob('/hero-frames/frame-*.webp', { eager: true, import: 'default' });
const frameUrls = Object.keys(frameModules).sort().map(k => frameModules[k] as string);
const FRAME_COUNT = frameUrls.length;
const FPS = 36;
const FRAME_DURATION_MS = 1000 / FPS;
const TOTAL_DURATION_MS = FRAME_COUNT * FRAME_DURATION_MS;

const POSTER_SRC = frameUrls[0] || '/og-default.png';
---

<figure class="hero-figure" data-hero-figure>
  <div class="hero-figure__drift" data-hero-figure-drift>
    <div class="hero-figure__stage" data-hero-figure-stage>
      <!-- Skeleton loader — shows while frames load -->
      <div class="hero-figure__skeleton" aria-hidden="true">
        <div class="hero-figure__skeleton-sheet"></div>
        <div class="hero-figure__skeleton-margin"></div>
        <div class="hero-figure__skeleton-rail"></div>
        <div class="hero-figure__skeleton-crew"></div>
        <div class="hero-figure__skeleton-frame"></div>
        <div class="hero-figure__skeleton-stamp"></div>
      </div>

      <!-- Frame container - uses CSS animation to cycle through frames -->
      <div
        class="hero-figure__frames"
        data-hero-figure-frames
        style="--frame-count: {FRAME_COUNT}; --frame-duration: {FRAME_DURATION_MS}ms;"
        aria-hidden="true"
      >
        {frameUrls.map((url, i) => (
          <img
            class="hero-figure__frame"
            src={url}
            alt=""
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            style={`--frame-index: ${i}; --frame-url: url(${url});`}
            aria-hidden="true"
          />
        ))}
      </div>
    </div>
  </div>

  <figcaption class="hero-figure__caption">
    <span class="hero-figure__index">Fig. 01</span>
    <span class="hero-figure__note">One brief. Five stages. Two people.</span>
    <span class="hero-figure__readout" aria-hidden="true">
      <span class="hf-phase hf-phase--brief">Brief</span>
      <span class="hf-phase hf-phase--spec">Spec</span>
      <span class="hf-phase hf-phase--build">Build</span>
      <span class="hf-phase hf-phase--verify">Verify</span>
      <span class="hf-phase hf-phase--ship">Ship</span>
    </span>
  </figcaption>
</figure>

<style>
  /* Frame container - uses CSS animation to cycle through frames */
  .hero-figure__frames {
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: 640 / 360; /* Match extracted frame dimensions */
  }

  .hero-figure__frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: frame-cycle var(--frame-duration) steps(1, end) infinite;
    animation-delay: calc(var(--frame-index) * var(--frame-duration) * -1);
    will-change: opacity;
  }

  @keyframes frame-cycle {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Reduced motion: show only first frame */
  @media (prefers-reduced-motion: reduce) {
    .hero-figure__frame {
      animation: none !important;
      opacity: 0;
    }
    .hero-figure__frame:first-child {
      opacity: 1;
    }
    .hero-figure__skeleton {
      display: none;
    }
  }

  /* Stage — reserves space before frames load */
  .hero-figure__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 640 / 360;
    background-color: var(--bg-raised);
    overflow: hidden;
  }

  /* Skeleton — matches the hero figure's visual structure */
  .hero-figure__skeleton {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 12% 8% 10%;
    gap: 6%;
    background: var(--bg-raised);
    transition: opacity 300ms ease-out;
    z-index: 1;
  }

  .hero-figure__skeleton.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .hero-figure__skeleton-sheet {
    background: var(--lift-1);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    height: 100%;
    position: relative;
  }

  .hero-figure__skeleton-margin {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 6%;
    height: 1px;
    background: var(--line);
  }

  .hero-figure__skeleton-rail {
    position: absolute;
    right: 8%;
    top: 10%;
    bottom: 10%;
    width: 2px;
    background: var(--line);
  }

  .hero-figure__skeleton-rail::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 30%;
    background: var(--accent);
    transform-origin: top;
    animation: skeleton-rail-fill 2s ease-out infinite;
  }

  @keyframes skeleton-rail-fill {
    0% { transform: scaleY(0); }
    50% { transform: scaleY(1); }
    100% { transform: scaleY(0); }
  }

  .hero-figure__skeleton-crew {
    position: absolute;
    right: 8%;
    bottom: 10%;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-end;
  }

  .hero-figure__skeleton-crew span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-faint);
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .hero-figure__skeleton-crew span:first-child {
    background: var(--accent);
    animation-delay: -0.5s;
  }

  @keyframes skeleton-pulse {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  .hero-figure__skeleton-frame {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 18%;
    height: 28%;
    border: 1px solid var(--line-strong);
    background: var(--lift-1);
    animation: skeleton-frame-build 2s ease-out infinite;
  }

  @keyframes skeleton-frame-build {
    0% { transform: scaleX(0); transform-origin: left; }
    50% { transform: scaleX(1); transform-origin: left; }
    100% { transform: scaleX(0); transform-origin: right; }
  }

  .hero-figure__skeleton-stamp {
    position: absolute;
    right: 12%;
    bottom: 6%;
    width: 24px;
    height: 24px;
    border: 2px solid var(--accent-deep);
    background: var(--lift-1);
    opacity: 0;
    animation: skeleton-stamp 2s ease-out infinite;
  }

  @keyframes skeleton-stamp {
    0%, 60% { opacity: 0; transform: scale(0.5); }
    80%, 100% { opacity: 1; transform: scale(1); }
  }

  /* Frames fade in when first frame loads */
  .hero-figure__frames.is-loaded {
    opacity: 1;
  }

  .hero-figure__frames {
    opacity: 0;
    transition: opacity 400ms ease-out;
  }

  /* Drift container receives the parallax transform */
  .hero-figure__drift {
    will-change: transform;
  }
</style>

<script>
  /* One driver, one figure.
   *
   * src/scripts/hero-driver.ts owns pointer position and hero scroll progress
   * and publishes them as CSS custom properties. The figure reads them for
   * parallax drift and lift as the hero scrolls out.
   */
  import { mountHeroDriver, type HeroDriver } from '~/scripts/hero-driver';

  let driver: HeroDriver | null = null;

  function teardown(): void {
    driver?.destroy();
    driver = null;
    document.querySelector<HTMLElement>('[data-hero-figure]')?.removeAttribute('data-mounted');
  }

  function mount(): void {
    const figure = document.querySelector<HTMLElement>('[data-hero-figure]');
    if (!figure || figure.dataset.mounted === 'true') return;

    const hero = figure.closest<HTMLElement>('.hero');
    if (!hero) return;

    driver = mountHeroDriver(hero);
    if (!driver) return;

    figure.dataset.mounted = 'true';
  }

  /* Frame lazy-load + skeleton handoff */
  function initFrames(): void {
    const figure = document.querySelector<HTMLElement>('[data-hero-figure]');
    if (!figure) return;

    const framesContainer = figure.querySelector<HTMLElement>('.hero-figure__frames');
    const skeleton = figure.querySelector<HTMLElement>('.hero-figure__skeleton');
    if (!framesContainer || !skeleton) return;

    // When first frame loads, fade in frames and hide skeleton
    const firstFrame = framesContainer.querySelector<HTMLImageElement>('.hero-figure__frame');
    if (!firstFrame) return;

    const handleLoad = () => {
      framesContainer.classList.add('is-loaded');
      skeleton.classList.add('is-hidden');
      setTimeout(() => skeleton.remove(), 400);
      firstFrame.removeEventListener('load', handleLoad);
    };

    if (firstFrame.complete) {
      handleLoad();
    } else {
      firstFrame.addEventListener('load', handleLoad, { once: true });
    }

    // Start loading frames when hero is near viewport (IntersectionObserver)
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          // Force load first frame by accessing it
          firstFrame.src = firstFrame.src;
          io.unobserve(entry.target);
          break;
        }
      }
    }, { rootMargin: '200px', threshold: 0.01 });

    io.observe(figure);
  }

  document.addEventListener('astro:page-load', () => {
    mount();
    initFrames();
  });
  document.addEventListener('astro:before-swap', teardown);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      mount();
      initFrames();
    }, { once: true });
  } else {
    mount();
    initFrames();
  }
</script>