---
/**
 * HeroFigure — the hero's right column: the ledger, being worked.
 *
 * The studio's idea is a ledger with one line through it: what we run above,
 * what we build for you below. The figure is that idea, drawn and then set in
 * motion — two lines, one method, one delivery.
 *
 * The drawing
 * -----------
 * A hairline sheet, ruled with exactly two lines:
 *
 *   * the upper line — the method — carries three stations: Build, Run, Ship;
 *   * the lower line — the work — is what each station leaves behind.
 *
 * Two people are two dots riding the upper line. They arrive together, take
 * each station in turn, and every finished stage drops a hairline down to the
 * lower line — a receipt, landing where we build for you. Run drops a check.
 * Ship drops a crate with a flag, and the crate rides the lower line out of
 * the sheet to the right, with both people following it off the edge.
 *
 * The loop is twelve seconds and resets by fading, then the next build walks
 * in from the left.
 *
 * Three states, in order of preference:
 *
 *   1. Driven: the sheet answers the pointer with a few pixels of parallax
 *      and lifts as the hero scrolls out.
 *   2. Animated: the loop runs on its own, on touch too — no pointer, no
 *      script.
 *   3. Poster: under reduced motion the same composition is frozen at the
 *      delivery moment — receipts down, check drawn, crate at the edge, flag
 *      up, both people right behind it.
 *
 * Plain SVG, plain CSS, no JavaScript beyond the driver it shares.
 * Decorative by contract: the hero's words carry the meaning.
 */
---

<figure class="hero-figure" data-hero-figure>
  <div class="hero-figure__drift" data-hero-figure-drift>
    <div class="hero-figure__stage" data-hero-figure-stage>
      <svg class="hero-figure__static" viewBox="0 56 400 264" aria-hidden="true" focusable="false">
        {/* The sheet: a hairline bound, nothing else. It is the page this
            studio ships. Its rule band is vertically balanced against the
            two lines it carries. */}
        <rect class="hf-sheet" x="22" y="88" width="356" height="200" />

        {/* The upper line: what we run. The method's spine. */}
        <line class="hf-run-line" x1="22" y1="150" x2="378" y2="150" />

        {/* The lower line: what we build for you. */}
        <line class="hf-built-line" x1="22" y1="250" x2="378" y2="250" />

        {/*
          The pair — two people, riding the upper line. The move layer carries
          their walk, the bob layer keeps them breathing while they stand.
        */}
        <g class="hf-pair">
          <g class="hf-pair-bob">
            <circle class="hf-dot hf-dot--lead" cx="102" cy="150" r="3.4" />
            <circle class="hf-dot hf-dot--follow" cx="118" cy="150" r="3.4" />
          </g>
        </g>

        {/* Station 1 · Build */}
        <g class="hf-station hf-station--build">
          <line class="hf-tick" x1="110" y1="150" x2="110" y2="138" />
          <text class="hf-label" x="110" y="132" text-anchor="middle">Build</text>
          {/* The receipt: a drop, and the work landing on the lower line. */}
          <line class="hf-drop" x1="110" y1="150" x2="110" y2="250" />
          <rect class="hf-land" x="102" y="247" width="16" height="3.2" />
        </g>

        {/* Station 2 · Run */}
        <g class="hf-station hf-station--run">
          <line class="hf-tick" x1="212" y1="150" x2="212" y2="138" />
          <text class="hf-label" x="212" y="132" text-anchor="middle">Run</text>
          {/* The check: the stage receipt, drawn to the right of the tick —
              clear of the label above and the dots standing at the station. */}
          <path class="hf-check" d="M220 141 l5 6 l10 -13" />
          <line class="hf-drop" x1="212" y1="150" x2="212" y2="250" />
          <rect class="hf-land" x="204" y="247" width="16" height="3.2" />
        </g>

        {/* Station 3 · Ship */}
        <g class="hf-station hf-station--ship">
          <line class="hf-tick" x1="314" y1="150" x2="314" y2="138" />
          <text class="hf-label" x="314" y="132" text-anchor="middle">Ship</text>
          <line class="hf-drop" x1="314" y1="150" x2="314" y2="250" />
          <rect class="hf-land" x="306" y="247" width="16" height="3.2" />
        </g>

        {/*
          The crate: the delivered build, riding the lower line out of the
          sheet. Its flag pops on it at the ship station.
        */}
        <g class="hf-crate">
          <rect class="hf-crate-body" x="296" y="236" width="22" height="14" />
          <line class="hf-line hf-line--faint" x1="296" y1="243" x2="318" y2="243" />
          <line class="hf-line hf-line--faint" x1="307" y1="236" x2="307" y2="250" />
          <g class="hf-flag">
            <line class="hf-line" x1="307" y1="236" x2="307" y2="222" />
            <path class="hf-flag-mark" d="M307 222 l10 3.6 l-10 3.6 z" />
          </g>
        </g>
      </svg>
    </div>
  </div>

  <figcaption class="hero-figure__caption">
    <span class="hero-figure__index">Fig. 01</span>
    <span class="hero-figure__note">One method. Two lines. Two people.</span>
    <span class="hero-figure__readout" aria-hidden="true">
      <span class="hf-phase hf-phase--build">Build</span>
      <span class="hf-phase hf-phase--run">Run</span>
      <span class="hf-phase hf-phase--ship">Ship</span>
    </span>
  </figcaption>
</figure>

<script>
  /*
   * One driver, one figure.
   *
   * src/scripts/hero-driver.ts owns pointer position and hero scroll progress
   * and publishes them as custom properties. The figure reads them for a few
   * pixels of parallax and for the lift as the hero scrolls out — that is the
   * whole of this module's job. The loop itself is CSS.
   */
  import { mountHeroDriver, type HeroDriver } from '~/scripts/hero-driver';

  let driver: HeroDriver | null = null;

  function teardown(): void {
    driver?.destroy();
    driver = null;
    document.querySelector<HTMLElement>('[data-hero-figure]')?.removeAttribute('data-mounted');
  }

  function mount(): void {
    const figure = document.querySelector<HTMLElement>('[data-hero-figure]');
    if (!figure || figure.dataset.mounted === 'true') return;

    const hero = figure.closest<HTMLElement>('.hero');
    if (!hero) return;

    driver = mountHeroDriver(hero);
    /* No driver means touch, reduced motion or no script: the static
       composition is the design, not a fallback. */
    if (!driver) return;

    figure.dataset.mounted = 'true';
  }

  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', teardown);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mount, { once: true });
  } else {
    mount();
  }
</script>
