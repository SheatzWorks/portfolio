---
/**
 * Measured outcomes.
 *
 * Renders only when a project has genuinely measured figures. There is no
 * fallback and no placeholder slot — a stat that is not real is worse than no
 * stat, so the component is simply not called.
 */
interface Props {
  metrics: { label: string; value: string; note?: string }[];
}

const { metrics } = Astro.props;
---

<div class="metrics">
  {
    metrics.map((metric) => (
      <div class="metric">
        <p class="metric__value">{metric.value}</p>
        <p class="metric__label">{metric.label}</p>
        {metric.note && <p class="metric__note">{metric.note}</p>}
      </div>
    ))
  }
</div>
