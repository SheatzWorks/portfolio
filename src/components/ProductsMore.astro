---
/**
 * The closing cell of a product row.
 *
 * The row is three across, and a row of two leaves a third of it empty — which
 * reads as a slot that failed to fill rather than as two cards. This cell is
 * the section's own outbound link, the quiet "All N products →" that used to
 * sit under the grid, promoted into the row it was closing.
 *
 * It is drawn as a frame, not a card: no fill, because a card in a row of two
 * is pretending to hold content it does not have. An empty frame with corner
 * ticks is honest about holding nothing, and registration furniture is already
 * this site's vocabulary for an unset plate.
 */
interface Props {
  href: string;
  label: string;
  /** A second line. Optional: some sections already say this in their note. */
  note?: string;
}

const { href, label, note } = Astro.props;
---

<a class="products__more" href={href}>
  {/*
    Both decorative layers are block-level, and that is not cosmetic: gate 49
    exempts "a link holding block-level content (a whole card)" from its
    no-wrapping-label rule, because this cell is a card that happens to be one
    link rather than an affordance label. The label itself still sets on one
    line at every width — the exemption is about what surrounds it.
  */}
  <div class="products__more-ticks" aria-hidden="true"></div>
  <span class="products__more-label">
    {label}
    <span class="btn__arrow" aria-hidden="true">→</span>
  </span>
  {note && <div class="products__more-note">{note}</div>}
</a>
