---
/**
 * N6 · Masthead navigation.
 *
 * Replaces the wordmark-left / link-row / button-right / hairline combination
 * that is the machine-generated default. The wordmark is set in the display
 * face at masthead size so it reads as a masthead rather than a logo, the
 * destinations sit in the mono face, and there is no filled button on the
 * right — the primary destination is distinguished by accent colour alone.
 */
import { studio } from '~/config/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/work', label: 'Work' },
  { href: '/products', label: 'Products' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'Studio' },
  { href: '/contact', label: 'Contact', primary: true },
];

/*
 * Exact path match only.
 *
 * The previous version stripped the `#` fragment and compared paths, so on `/`
 * both an in-page anchor and the home route resolved to `aria-current="page"`
 * — the built HTML carried the attribute twice.
 */
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="masthead">
  <div class="shell masthead__inner">
    <a class="masthead__brand" href="/">
      <span class="masthead__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <g class="mark-spark">
            <path d="M11.5 2.8C12.7 7.6 11.7 13.6 12.7 21.2" />
            <path d="M4.4 5C8.9 9.3 14.4 14.3 19.7 18.6" />
            <path d="M5.6 18.8C9.9 14.5 14.9 9.5 19.4 5.2" />
          </g>
          <path class="mark-swipe" d="M3 12.1C8 10.8 16 10.3 21 11.4 16 13.5 8 13.7 3 12.1Z" />
        </svg>
      </span>{studio.name}
    </a>

    <nav class="masthead__nav" id="masthead-nav" data-open="false" aria-label="Main">
      <ul class="masthead__list">
        {
          links.map((link) => (
            <li>
              <a
                class:list={['masthead__link', link.primary && 'masthead__link--primary']}
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="masthead__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="masthead-nav"
      data-nav-toggle
    >
      <span class="masthead__bars" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
      <span data-nav-label>Menu</span>
    </button>
  </div>
</header>

<script>
  function init() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const nav = document.querySelector<HTMLElement>('#masthead-nav');
    const label = document.querySelector<HTMLElement>('[data-nav-label]');
    if (!toggle || !nav) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.dataset.open = String(open);
      document.body.dataset.navOpen = String(open);
      if (label) label.textContent = open ? 'Close' : 'Menu';
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Leaving the mobile breakpoint must not leave a locked body scroll.
    const mq = window.matchMedia('(min-width: 48rem)');
    mq.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>
