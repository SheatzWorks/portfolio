---
/**
 * Site header.
 *
 * Navigation is four items plus a contact shortcut — the pattern the strongest
 * current studio sites converge on. A mega-menu would be decoration; the site
 * has five routes.
 *
 * The header is sticky and gains a hairline bottom border on scroll. It
 * condenses by reducing min-height (a layout property on a fixed-height bar,
 * which the browser cannot reflow content around) rather than by scaling.
 */
import { studio } from '~/config/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/creations', label: 'Creations' },
  { href: '/studio', label: 'Studio' },
  { href: '/#services', label: 'Services' },
  { href: '/#process', label: 'Process' },
];

const isCurrent = (href: string) => {
  const path = href.split('#')[0];
  if (path === '/') return currentPath === '/';
  return currentPath === path || currentPath.startsWith(`${path}/`);
};
---

<header class="site-header" data-scrolled="false" data-site-header>
  <div class="shell site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true"></span>
      <span>{studio.name}</span>
    </a>

    <nav class="site-nav" id="site-nav" data-open="false" aria-label="Main">
      <ul class="site-nav__list">
        {
          links.map((link) => (
            <li>
              <a
                class="site-nav__link"
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="site-nav__footer">
        <a class="copy-email" href={`mailto:${studio.email}`} data-copy-email>
          <span>{studio.email}</span>
          <span class="copy-email__state" data-copy-state aria-hidden="true"></span>
        </a>
        <a class="btn btn--primary" href="/contact">Start a project</a>
      </div>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--primary" href="/contact">Start a project</a>
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-nav-toggle
      >
        <span class="nav-toggle__bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
        <span data-nav-label>Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  // Progressive enhancement only. Without JS the nav renders as a normal
  // desktop list and the toggle is a dead button that the <noscript>-less
  // markup still keeps out of the accessibility tree via `hidden` on mobile.
  function init() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const nav = document.querySelector<HTMLElement>('#site-nav');
    const label = document.querySelector<HTMLElement>('[data-nav-label]');
    if (!header || !toggle || !nav) return;

    // --- scrolled state -------------------------------------------------
    const onScroll = () => {
      header.dataset.scrolled = String(window.scrollY > 8);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // --- menu open/close ------------------------------------------------
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.dataset.open = String(open);
      document.body.dataset.navOpen = String(open);
      if (label) label.textContent = open ? 'Close' : 'Menu';
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close on navigation within the menu, and on Escape from anywhere.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Leaving the mobile breakpoint must not leave a locked body scroll.
    const mq = window.matchMedia('(min-width: 48rem)');
    mq.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>
