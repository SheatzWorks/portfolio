---
/**
 * Ft5 · Statement footer.
 *
 * A closing line, the email, and the destinations. The previous footer was
 * three link columns over a hairline — the shape every template ships. This
 * one leads with a statement, which is what a two-person studio can actually
 * say and an agency cannot.
 */
import { studio, publishableSocial } from '~/config/site';
const year = new Date().getFullYear();

const nav = [
  { href: '/work', label: 'Work' },
  { href: '/products', label: 'Products' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'Studio' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---

<footer class="foot">
  <div class="shell">
    <p class="foot__statement">{studio.closing}</p>

    <a class="foot__email" href={`mailto:${studio.email}`} data-copy-email title="Copy email address">
      <span>{studio.email}</span>
      <span class="copy-email__state" data-copy-state aria-live="polite"></span>
    </a>

    <ul class="foot__nav">
      {
        nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>

    <div class="foot__base">
      <span>© {year} {studio.name}</span>
      {
        publishableSocial()
          .map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label}
            </a>
          ))
      }
      <span class="foot__status">
        <span class="status-dot" aria-hidden="true"></span>
        Available for new work
      </span>
    </div>
  </div>
</footer>

<script>
  /**
   * Click-to-copy on the email address. Falls back to opening the mail client
   * when the clipboard is unavailable (insecure context, denied permission).
   *
   * This is the only copy handler on the site: `contact.astro` used to carry a
   * second one, so a single click ran both and the confirmation raced itself.
   * `astro:page-load` re-binds after a client-side swap; the guard stops a
   * node that survived from getting two listeners.
   */
  function initCopy() {
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-copy-email]')) {
      if (link.dataset.copyBound === 'true') continue;
      link.dataset.copyBound = 'true';

      const state = link.querySelector<HTMLElement>('[data-copy-state]');
      const email = link.getAttribute('href')?.replace(/^mailto:/, '') ?? '';
      if (!email) continue;

      link.addEventListener('click', async (event) => {
        // A modified click is a request to hand off to the OS, not to copy.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        try {
          await navigator.clipboard.writeText(email);
          if (state) {
            state.textContent = 'Copied';
            setTimeout(() => (state.textContent = ''), 1800);
          }
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initCopy);
</script>
