---
/**
 * Ft5 · Statement footer.
 *
 * A closing line, the email, and the destinations. The previous footer was
 * three link columns over a hairline — the shape every template ships. This
 * one leads with a statement, which is what a two-person studio can actually
 * say and an agency cannot.
 */
import { studio, publishableSocial, publishableEmail, mailtoHref, enquiryDraft } from '~/config/site';
const year = new Date().getFullYear();
const email = publishableEmail();
const mailto = mailtoHref(enquiryDraft('New project enquiry'));

const nav = [
  { href: '/work', label: 'Work' },
  { href: '/products', label: 'Products' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'Studio' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---

<footer class="foot">
  <div class="shell">
    <p class="foot__statement">{studio.closing}</p>

    {email && mailto ? (
      <>
        {/*
          The link now navigates instead of copying. Copying on click looked
          clever and was wrong on the two things it touched: it silently
          swallowed the hand-off every visitor actually wanted — a compose
          window already addressed — and on a device with no mail client
          configured it appeared to do nothing at all. Copy is still here, as
          its own control, because the address is worth being able to paste.
        */}
        <a class="foot__email" href={mailto}>{email}</a>
        <button
          type="button"
          class="foot__copy"
          data-copy-email={email}
          aria-label={`Copy ${email}`}>Copy</button>
        <span class="copy-email__state" data-copy-state aria-live="polite"></span>
      </>
    ) : (
      /* The mailbox is unresolved. The slot keeps its weight but points at the
         form, which works with no configuration — a dead mailto: to a
         placeholder domain is the one thing this footer must never ship. */
      <a class="foot__email" href="/contact">
        <span>Start a project</span>
        <span class="copy-email__state" data-copy-state aria-live="polite"></span>
      </a>
    )}

    <ul class="foot__nav">
      {
        nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>

    <div class="foot__base">
      <span>© {year} {studio.name}</span>
      {
        publishableSocial()
          .map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label}
            </a>
          ))
      }
      <span class="foot__status">
        <span class="status-dot" aria-hidden="true"></span>
        Available for new work
      </span>
    </div>
  </div>
</footer>

<script>
  /**
   * Click-to-copy on the email address — now a button of its own rather than
   * a hijacked link, so opening the mail client and copying the address are
   * two different actions with two different affordances.
   *
   * `astro:page-load` re-binds after a client-side swap; the guard stops a
   * node that survived from getting two listeners.
   */
  function initCopy() {
    for (const button of document.querySelectorAll<HTMLButtonElement>(
      'button[data-copy-email]',
    )) {
      if (button.dataset.copyBound === 'true') continue;
      button.dataset.copyBound = 'true';

      const address = button.dataset.copyEmail ?? '';
      if (!address) continue;
      // The status slot sits next to the button in the footer and wraps the
      // control on the contact page, so look for both shapes.
      const state =
        button.parentElement?.querySelector<HTMLElement>('[data-copy-state]') ??
        button.querySelector<HTMLElement>('[data-copy-state]');
      const label = button.dataset.copyLabel ?? button.textContent ?? 'Copy';

      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(address);
          button.textContent = 'Copied';
          if (state) state.textContent = '';
        } catch {
          // No clipboard (insecure context, denied permission). Say so rather
          // than pretending the copy happened.
          button.textContent = 'Press and hold';
          if (state) state.textContent = address;
        }
        setTimeout(() => {
          button.textContent = label;
          if (state) state.textContent = '';
        }, 1800);
      });
    }
  }

  document.addEventListener('astro:page-load', initCopy);
</script>
