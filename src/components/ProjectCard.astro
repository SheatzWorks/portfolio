---
/**
 * Project card.
 *
 * Interaction budget, kept deliberately low:
 *   - the whole card is one link (no nested interactive controls to tab through)
 *   - a still image always paints first
 *   - a video, when one exists, replaces it only on hover/focus on pointer
 *     devices; on touch the still is what the user gets, because autoplaying
 *     video on a metered mobile connection is the wrong trade
 *   - tags are plain text, not links, so they do not add tab stops
 *
 * Nothing here can render broken: `resolvePreview` guarantees a non-empty image
 * URL or a designed plate.
 */
import type { Project, ResolvedPreview } from '~/lib/types';
import { safeAspectRatio, arBucketFor } from '~/lib/preview';

interface Props {
  project: Project;
  preview: ResolvedPreview;
  /** Grid position, drives the fractional column span. */
  span?: 'a' | 'b' | 'c' | 'd' | 'full';
  /** Eagerly load the first row's media; the rest stay lazy. */
  priority?: boolean;
}

const { project, preview, span = 'a', priority = false } = Astro.props;

const ar = safeAspectRatio(project.aspectRatio);
// A data attribute rather than an inline style: the CSP does not allow style
// attributes, and hashing every possible ratio is not worth 400 bytes of CSS.
const arBucket = arBucketFor(ar);
const href = project.hasCaseStudy ? `/work/${project.slug}` : project.url;
const isExternal = href === project.url;
const title = project.title;
const accessibleName = `${project.title} — ${project.blurb ?? project.url}`;

/*
 * `sizes` has to describe the slot the card actually occupies, or the browser
 * picks the wrong candidate: a 4-column card asking for 46vw downloads an
 * image twice the size it can display. These mirror the spans in
 * components.css — 7/5 above 40rem, then 8/4 at 64rem.
 */
const SIZES: Record<NonNullable<Props['span']>, string> = {
  full: '100vw',
  a: '(min-width: 40rem) 58vw, 100vw',
  b: '(min-width: 40rem) 42vw, 100vw',
  c: '(min-width: 64rem) 67vw, (min-width: 40rem) 58vw, 100vw',
  d: '(min-width: 64rem) 33vw, (min-width: 40rem) 42vw, 100vw',
};
const sizes = SIZES[span];
---

<article class="work-grid__item" data-span={span} data-project={project.slug}>
  <a
    class="project"
    href={href}
    {...isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
    aria-label={accessibleName}
    data-ar={arBucket.name}
    data-project-card
    data-has-video={preview.videoUrl ? 'true' : 'false'}
  >
    <div class="project__media">
      <span class="project__placeholder" data-plate hidden>{project.title}</span>
      {
        preview.imageUrl && (
          <img
            class="project__img"
            src={preview.imageUrl}
            srcset={preview.srcset}
            sizes={sizes}
            alt=""
            width={preview.width ?? 1440}
            height={preview.height ?? Math.round(1440 / ar)}
            loading={priority ? 'eager' : 'lazy'}
            decoding={priority ? 'sync' : 'async'}
            fetchpriority={priority ? 'high' : 'auto'}
            /* If the external image 404s or is blocked, fall back to the
               designed plate rather than showing a broken-image glyph. One
               unreachable third party must not damage the grid. */
            data-img-fallback
          />
        )
      }

      {
        preview.videoUrl && (
          <video
            class="project__video"
            data-project-video
            src={preview.videoUrl}
            poster={preview.videoPoster ?? preview.imageUrl}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            tabindex={-1}
          />
        )
      }
    </div>

    <div class="project__body">
      <h3 class="project__title">{title}</h3>
      {project.blurb && <p class="project__blurb">{project.blurb}</p>}

      {
        (project.technologies.length > 0 || project.year) && (
          <ul class="project__tags">
            {project.technologies.slice(0, 4).map((tech) => (
              <li>{tech}</li>
            ))}
            {project.year && <li class="project__year">{project.year}</li>}
          </ul>
        )
      }
    </div>
  </a>
</article>

<script>
  /**
   * Video-on-hover for pointer devices only.
   *
   * Guarded by `matchMedia('(hover: hover)')` so this never runs on a phone,
   * and gated on `preload="none"` so no bytes are fetched until the pointer
   * actually arrives. `prefers-reduced-motion` skips it entirely.
   */
  function initVideo() {
    // Image error fallback first: an unreachable og: or favicon host must not
    // leave a broken-image glyph in the grid.
    for (const img of document.querySelectorAll<HTMLImageElement>('[data-img-fallback]')) {
      if (img.dataset.fallbackBound === 'true') continue;
      img.dataset.fallbackBound = 'true';
      const media = img.closest('.project__media');
      const plate = media?.querySelector<HTMLElement>('[data-plate]');
      const fallback = () => {
        img.remove();
        if (plate) plate.hidden = false;
      };
      // An image that failed before this listener existed (a cached error, or
      // a swap that finished first) never fires `error` again.
      if (img.complete && img.naturalWidth === 0) {
        fallback();
        continue;
      }
      img.addEventListener('error', fallback, { once: true });
    }

    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    if (!canHover.matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const cards = document.querySelectorAll<HTMLElement>('[data-project-card][data-has-video="true"]');

    for (const card of cards) {
      // ClientRouter replaces the body but keeps this module, so the same
      // handler must not be attached twice to a node that survived a swap.
      if (card.dataset.videoBound === 'true') continue;
      card.dataset.videoBound = 'true';

      const video = card.querySelector<HTMLVideoElement>('[data-project-video]');
      if (!video) continue;

      let playing = false;

      const play = async () => {
        if (playing) return;
        try {
          await video.play();
          playing = true;
          card.dataset.videoPlaying = 'true';
        } catch {
          // Autoplay refused. The poster frame is already showing, which is a
          // complete and acceptable result.
        }
      };

      const stop = () => {
        if (!playing) return;
        video.pause();
        video.currentTime = 0;
        playing = false;
        card.dataset.videoPlaying = 'false';
      };

      card.addEventListener('pointerenter', play);
      card.addEventListener('pointerleave', stop);
      // Keyboard users get the still: focus is not a hover.
    }
  }

  /*
   * `astro:page-load` fires on first load and after every ClientRouter swap,
   * which is the only hook that survives client-side navigation. The module
   * itself loads once.
   */
  document.addEventListener('astro:page-load', initVideo);
</script>
