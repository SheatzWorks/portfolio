---
/**
 * Root document. Everything security- and SEO-relevant about <head> lives here
 * so no page can forget it.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/components.css';

import { ClientRouter } from 'astro:transitions';
import { studio, publishableSocial } from '~/config/site';
import SiteNav from '~/components/SiteNav.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import { getEnv } from '~/lib/env';

interface Props {
  title: string;
  description: string;
  /** Path-only canonical, e.g. '/work'. */
  canonicalPath?: string;
  /** Absolute or media-relative image for social cards. */
  ogImage?: string;
  ogImageAlt?: string;
  /** 'website' for the home page, 'article' for a case study. */
  ogType?: 'website' | 'article';
  /** Extra JSON-LD objects appended to the page-level graph. */
  jsonLd?: unknown[];
  /** Hide the footer (used by the admin shell, which has its own chrome). */
  chrome?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  jsonLd = [],
  chrome = true,
  bodyClass,
} = Astro.props;

const env = await getEnv(Astro.locals);
const siteUrl = env.PUBLIC_SITE_URL || studio.siteUrl;
const canonical = new URL(canonicalPath, siteUrl).toString();
const ogUrl = ogImage ? new URL(ogImage, siteUrl).toString() : `${siteUrl.replace(/\/+$/, '')}/og-default.png`;

// One connected graph. Organization + WebSite always; page-specific nodes
// (CreativeWork / BreadcrumbList) are appended by the page.
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl.replace(/\/+$/, '')}/#organization`,
      name: studio.name,
      url: siteUrl,
      description: studio.description,
      email: studio.email,
      ...(studio.location ? { address: { '@type': 'PostalAddress', addressLocality: studio.location } } : {}),
      // Filtered, not raw: an unresolved placeholder must not reach
      // sameAs, where it would be indexed as a real profile.
      ...(publishableSocial().length
        ? { sameAs: publishableSocial().map((s) => s.href) }
        : {}),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.replace(/\/+$/, '')}/#website`,
      url: siteUrl,
      name: studio.name,
      description: studio.description,
      publisher: { '@id': `${siteUrl.replace(/\/+$/, '')}/#organization` },
      inLanguage: 'en',
    },
    ...jsonLd,
  ],
};

// Serialised safely: Astro's set:html would otherwise allow a project
// description containing "</script>" to terminate the block early.
const jsonLdPayload = JSON.stringify(graph).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/*
      MPA view transitions, not an SPA. Each page is still a full document with
      its own canonical, CSP and metadata; the router only replaces the body.
      The treatment is one quiet rise — see the ::view-transition rules in
      global.css. No loader: the pages arrive in milliseconds, and a fake one
      would be dishonest.
    */}
    <ClientRouter />

    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f2f5fb" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    {/*
      Scroll-revealed content is hidden from the first byte — that is what
      stops it painting visible and then vanishing when the class flips. With
      no JS nothing ever flips it back, so this override is the only thing
      standing between a JS-off visitor and a blank page. A real file, because
      an inline <style> would not survive the CSP.
    */}
    <noscript>
      <link rel="stylesheet" href="/no-js.css" />
    </noscript>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={studio.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:alt" content={ogImageAlt ?? `${title} — ${studio.name}`} />
    <meta property="og:locale" content="en" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={jsonLdPayload} is:inline />

    <link
      rel="preload"
      href="/fonts/newsreader-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/plexsans-var.woff2" as="font" type="font/woff2" crossorigin />
    {/*
      The mono face is small (6.4KB) but appears in 60 rules — every eyebrow,
      label, price and index on the site. It was the only face not preloaded,
      which left a late swap window that intermittently reflowed the mono
      labels on the text-heaviest pages. Preloading it closes that window.
    */}
    <link rel="preload" href="/fonts/plexmono-500.woff2" as="font" type="font/woff2" crossorigin />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>

    {chrome && <SiteNav currentPath={Astro.url.pathname} />}

    <main id="main">
      <slot />
    </main>

    {chrome && <SiteFooter />}

    {chrome && <div class="scroll-progress" aria-hidden="true"></div>}

    {/*
      Not `is:inline`: Astro cannot hash an inline script, so it would be
      blocked by the CSP it generates. As a bundled module Astro emits the
      hash itself.

      This module carries the reveal system, so `[data-reveal]` stays hidden
      only while it is missing — see src/scripts/motion.ts for why the
      `no-js` class is removed from inside the module rather than from here.
    */}
    <script>
      import '~/scripts/motion';
    </script>
  </body>
</html>
