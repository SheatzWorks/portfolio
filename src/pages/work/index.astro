---
/**
 * /work — commissioned work.
 *
 * There is no client work yet, and the honest version of an empty portfolio is
 * not an apology. This page states the situation, points at the products the
 * studio has actually built, and explains what happens to work here. A page
 * that only says "coming soon" is worse than no page, because it implies
 * there is something behind it.
 *
 * Filters appear only once there are enough projects to filter.
 */
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import WorkGrid from '~/components/WorkGrid.astro';
import { getEnv, hasDb } from '~/lib/env';
import { listClientWork, countByOwnership } from '~/lib/db';
import type { Project, ProjectKind } from '~/lib/types';

export const prerender = false;

const env = await getEnv(Astro.locals);

let projects: Project[] = [];
let ownCount = 0;

if (hasDb(env)) {
  const db = env.DB as never;
  [projects, { own: ownCount }] = await Promise.all([
    listClientWork(db),
    countByOwnership(db),
  ]);
}

/** Below this, a filter bar is UI for its own sake. */
const FILTER_THRESHOLD = 8;

const KIND_LABELS: Record<ProjectKind, string> = {
  web: 'Websites',
  webapp: 'Web applications',
  mobile: 'Mobile',
  saas: 'SaaS',
  ai: 'AI',
  experiment: 'Experiments',
  client: 'Client work',
  internal: 'Internal',
};

const showFilters = projects.length >= FILTER_THRESHOLD;

const kinds = [...new Set(projects.map((p) => p.kind))].filter(
  (k): k is ProjectKind => k && k !== 'internal',
);
---

<Base title="Work" description="Commissioned software built by sheatz. Client work is listed with the client's permission; everything else the studio builds is under Products.">
  <section class="page-head">
    <div class="shell">
      <p class="eyebrow eyebrow--plain">Work</p>
      <h1 class="page-head__title">Built for someone else.</h1>
      <p class="page-head__lede">
        Commissioned software, published with the client's permission. Everything we build for
        ourselves is under <a href="/products">Products</a>.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="work-grid">
    <div class="shell">
      <header class="section-head" data-reveal>
        <p class="eyebrow eyebrow--plain">
          {
            projects.length === 0
              ? 'Nothing published yet'
              : `${projects.length} ${projects.length === 1 ? 'project' : 'projects'}`
          }
        </p>
        <div class="section-head__row">
          <h2 class="section-head__title" id="work-grid-title">Selected projects</h2>
        </div>
      </header>

      {
        showFilters && (
          <nav class="filters" aria-label="Filter projects">
            <a class="filters__chip filters__chip--on" href="/work" aria-current="true">
              All
            </a>
            {kinds.map((kind) => (
              <a class="filters__chip" href={`/work?kind=${kind}`}>
                {KIND_LABELS[kind]}
              </a>
            ))}
          </nav>
        )
      }

      {
        projects.length > 0 ? (
          <WorkGrid projects={projects} />
        ) : (
          /* Composed rather than apologetic: the empty state is a real page
             section that carries the argument, not a "nothing here" notice. */
          <div class="pointer" data-reveal>
            <p class="pointer__body">
              No client work has been approved for publication yet. That is a publishing decision,
              not an absence of work — and it is the reason this page says almost nothing rather
              than showing you a portfolio of things that do not exist.
            </p>
            <p class="pointer__body">
              In the meantime, the most honest evidence of what we build is what we build for
              ourselves.
            </p>
            <p>
              <a class="btn btn--secondary" href="/products">
                See our products
                <span class="btn__arrow" aria-hidden="true">→</span>
              </a>
            </p>
            {
              ownCount > 0 && (
                <p class="pointer__note">
                  {ownCount} {ownCount === 1 ? 'product' : 'products'} published, including work in
                  development.
                </p>
              )
            }
          </div>
        )
      }
    </div>
  </section>

  <Section id="work-policy" eyebrow="Publishing" title="Why this page is short.">
    <div class="prose">
      <p>
        We publish client work only with permission, and only where we can say something true about
        the result. A portfolio of screenshots nobody can verify is decoration.
      </p>
      <p>
        The products section is the part we can keep current without asking anyone, because we own
        them and we know exactly where they stand — including the parts that are not finished.
      </p>
      <p>
        If you are looking for evidence of how we work, the
        <a href="/services">services page</a> is more specific than a case study would be.
      </p>
    </div>
  </Section>

  <Section id="work-cta" eyebrow="Next" title="Have something of your own to build?">
    <p class="lede-para">
      No portfolio needed on your side. A description of the problem is enough to start.
    </p>
    <p>
      <a class="btn btn--primary" href="/contact">
        Start a project
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </p>
  </Section>
</Base>
