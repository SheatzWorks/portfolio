---
/**
 * Creations index.
 *
 * Server-rendered rather than prerendered: a project added in the admin must
 * appear here immediately, which is a hard requirement. The home page stays
 * prerendered because it is the LCP-critical route.
 *
 * Filters are rendered only when there are enough projects for them to be
 * useful. Below the threshold they would be UI for its own sake.
 */
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import CreationsGrid from '~/components/CreationsGrid.astro';
import EmptyState from '~/components/EmptyState.astro';
import { studio } from '~/config/site';
import { getEnv, hasDb } from '~/lib/env';
import { listPublishedProjects } from '~/lib/db';
import type { ProjectKind } from '~/lib/types';

export const prerender = false;

const env = await getEnv(Astro.locals);
const db = env.DB as never;

/** Below this, a filter bar is decoration rather than a control. */
const FILTER_THRESHOLD = 8;

const KIND_LABELS: Record<ProjectKind, string> = {
  web: 'Websites',
  webapp: 'Web applications',
  mobile: 'Mobile',
  saas: 'SaaS',
  ai: 'AI',
  experiment: 'Experiments',
  client: 'Client work',
  internal: 'Internal',
};

let projects: Awaited<ReturnType<typeof listPublishedProjects>> = [];
// A missing binding and a failing query are different faults and must not be
// presented the same way. Treating both as "no projects" would turn a data
// outage into a page that looks deliberately empty.
let bindingsMissing = false;
let loadError = false;

if (!hasDb(env)) {
  bindingsMissing = true;
} else {
  try {
    projects = await listPublishedProjects(db);
  } catch (err) {
    console.error(JSON.stringify({ event: 'creations.load_failed', error: String(err) }));
    loadError = true;
  }
}

// ?kind=... is validated against the known set. An unknown value shows
// everything rather than erroring, so a stale bookmark degrades to the index.
const rawKind = Astro.url.searchParams.get('kind');
const activeKind = rawKind && rawKind in KIND_LABELS ? (rawKind as ProjectKind) : null;

const filtered = activeKind ? projects.filter((p) => p.kind === activeKind) : projects;

const counts = projects.reduce<Record<string, number>>((acc, p) => {
  acc[p.kind] = (acc[p.kind] ?? 0) + 1;
  return acc;
}, {});

const presentKinds = (Object.keys(counts) as ProjectKind[]).sort(
  (a, b) => counts[b] - counts[a],
);

const showFilters = projects.length >= FILTER_THRESHOLD && presentKinds.length > 1;
---

<Base
  title={`Creations — ${studio.name}`}
  description={`Websites, web applications and product software built by ${studio.name}. Each entry links to the live thing.`}
  canonicalPath="/creations"
>
  <Section
    id="creations-index"
    eyebrow="Creations"
    title="Everything we have built"
    note={activeKind ? `${filtered.length} of ${projects.length}` : `${projects.length} total`}
    size="lg"
    headingLevel={1}
  >
    {
      showFilters && (
        <nav class="filters" aria-label="Filter by type">
          <a class="filter" href="/creations" aria-current={activeKind ? undefined : 'true'}>
            All<span class="filter__count">{projects.length}</span>
          </a>
          {presentKinds.map((kind) => (
            <a
              class="filter"
              href={`/creations?kind=${kind}`}
              aria-current={activeKind === kind ? 'true' : undefined}
            >
              {KIND_LABELS[kind]}
              <span class="filter__count">{counts[kind]}</span>
            </a>
          ))}
        </nav>
      )
    }

    {
      filtered.length > 0 ? (
        <CreationsGrid projects={filtered} priorityCount={3} />
      ) : loadError || bindingsMissing ? (
        <EmptyState
          title="The index is temporarily unavailable"
          body={
            bindingsMissing
              ? 'The content database is not configured on this deployment, so the creations index cannot be read. This is a configuration fault on our side, not a problem with your connection.'
              : 'The content database did not respond. This is a fault on our side, not a problem with your connection — the index returns as soon as it recovers.'
          }
          status="error"
        />
      ) : activeKind ? (
        <EmptyState
          title="Nothing in this category yet"
          body={`There are no ${KIND_LABELS[activeKind].toLowerCase()} in the index right now. Everything published so far is under another type.`}
          hint="Clear the filter to see all work."
        />
      ) : (
        <EmptyState
          title="The work goes here"
          body="Every published creation appears in this index automatically, each with a captured screenshot of the live site. Adding one takes a URL and nothing else."
          hint="Add one from /admin — a URL is all that is required."
        />
      )
    }
  </Section>

  <div class="shell">
    <section class="cta">
      <div>
        <h2 class="cta__title">Something here resemble your project?</h2>
        <p class="lede mt-4">
          If you can describe the thing you are trying to build, we can tell you
          how we would approach it and roughly what it takes.
        </p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--primary" href="/contact">Start a project</a>
        <a class="btn btn--secondary" href="/studio">About the studio</a>
      </div>
    </section>
  </div>
</Base>
