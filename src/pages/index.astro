---
/**
 * Home.
 *
 * The narrative, in order, with no section that does not earn its place:
 *
 *   1. Hero            — what this is, stated in one sentence.
 *   2. Products        — the strongest evidence the studio has, because it owns it.
 *   3. Work            — client commissions, or an honest composed panel.
 *   4. Services        — what it builds, with published ranges.
 *   5. Process         — how a project runs, written down in advance.
 *   6. Differentiators — the six practices that are actually true.
 *   7. Stack           — the tools, as a list rather than a logo wall.
 *   8. FAQ             — the questions that otherwise waste a first call.
 *   9. Closing         — a line and an email address.
 *
 * Server-rendered: every section reads D1 per request, with each read failing
 * independently, so a product or price saved in the admin appears here at once
 * rather than at the next build. TTFB is watched by scripts/perf.mjs (300ms
 * budget). See docs/architecture.md.
 */
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import HeroSketch from '~/components/HeroSketch.astro';
import ProductCard from '~/components/ProductCard.astro';
import ProductsMore from '~/components/ProductsMore.astro';
import WorkGrid from '~/components/WorkGrid.astro';
import { studio } from '~/config/site';
import { getEnv, hasDb } from '~/lib/env';
import {
  listOwnProducts,
  listClientWork,
  listServices,
  listDifferentiators,
  getSiteContent,
} from '~/lib/db';
import type { Product, Project, Service, Differentiator } from '~/lib/types';
import type { SiteContent } from '~/lib/db';

export const prerender = false;

const EMPTY_CONTENT: SiteContent = {
  faq: [],
  capabilities: [],
  process: [],
  servicesIntro: null,
  contactBlurb: null,
};

const env = await getEnv(Astro.locals);

let products: Product[] = [];
let clientWork: Project[] = [];
let services: Service[] = [];
let differentiators: Differentiator[] = [];
let content: SiteContent = EMPTY_CONTENT;

if (hasDb(env)) {
  const db = env.DB as never;
  // Each read is independent: a failure in one must not blank the whole page.
  const [p, w, s, d, c] = await Promise.all([
    listOwnProducts(db).catch(() => []),
    listClientWork(db).catch(() => []),
    listServices(db).catch(() => []),
    listDifferentiators(db).catch(() => []),
    getSiteContent(db).catch(() => EMPTY_CONTENT),
  ]);
  products = p;
  clientWork = w;
  services = s;
  differentiators = d;
  content = c;
}

/* Homepage depth. Four is enough to read as a selection rather than an index,
   and the full set lives on /work. */
const HOME_LIMIT = 4;

const shownWork = clientWork.slice(0, HOME_LIMIT);
const signatureServices = services.filter((s) => s.isSignature).slice(0, 4);
const shownServices = signatureServices.length > 0 ? signatureServices : services.slice(0, 3);

/** The row holds three; a fourth and beyond live on /products. */
const shownProducts = products.slice(0, 3);

/** A short FAQ on the home page; the full set lives on /about. */
const HOME_FAQ = content.faq.slice(0, 6);
---

<Base
  title={`${studio.name} — ${studio.tagline}`}
  description={studio.description}
  canonicalPath="/"
  ogType="website"
>
  <section class="hero">
    <div class="shell">
      <div class="hero__grid">
        <div class="hero__intro">
          <p class="eyebrow eyebrow--plain">{studio.hero.eyebrow}</p>

          <h1 class="hero__title">{studio.hero.heading}</h1>

          <p class="hero__lede">{studio.hero.lede}</p>

          <div class="hero__actions">
            <a class="btn btn--primary" href="/work">
              See the work
              <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
            <a class="btn btn--quiet" href="/contact">
              Start a project
            </a>
          </div>

          <dl class="hero__meta">
            <div class="hero__meta-item">
              <dt class="hero__meta-label">Focus</dt>
              <dd class="hero__meta-value">Web apps, mobile, on-device AI</dd>
            </div>
            <div class="hero__meta-item">
              <dt class="hero__meta-label">Engagement</dt>
              <dd class="hero__meta-value">Fixed scope, fixed price</dd>
            </div>
            <div class="hero__meta-item">
              <dt class="hero__meta-label">Status</dt>
              <dd class="hero__meta-value">
                <span class="status-dot" aria-hidden="true"></span>
                Available for new work
              </dd>
            </div>
            <div class="hero__meta-item">
              <dt class="hero__meta-label">Reply</dt>
              <dd class="hero__meta-value">Within a couple of days</dd>
            </div>
          </dl>
        </div>

        {/*
          The right column is the studio's own hand rather than another
          product card: the first card here was the same product section 02
          already leads with, so it doubled the claim instead of making one.
        */}
        <HeroSketch />
      </div>
    </div>
  </section>

{/*
  Products before work, deliberately. The studio's own software is the one
  claim here that does not depend on a client's permission to be published,
  so it goes first.
*/}
  {products.length > 0 && (
    <Section
      id="products"
      eyebrow="Products"
      title="Software we built and run ourselves."
      note="We own every line — no one else's permission needed."
    >
      <div class="products">
        {shownProducts.map((product) => (
          <ProductCard product={product} />
        ))}
        {/*
          The row is three across. Two cards and a void reads as a slot that
          did not fill, so the section's own outbound link closes it — and it
          only appears when the row would otherwise be short.
        */}
        {shownProducts.length % 3 !== 0 && (
          <ProductsMore
            href="/products"
            label={`All ${products.length} ${products.length === 1 ? 'product' : 'products'}`}
            note="Everything we run ourselves, in one list."
          />
        )}
      </div>
    </Section>
  )}

  {shownWork.length > 0 ? (
    <Section id="work" eyebrow="Work" title="Built for someone else.">
      <WorkGrid projects={shownWork} priorityCount={2} />
      <p class="section__more">
        <a class="btn btn--quiet" href="/work">
          All {clientWork.length} {clientWork.length === 1 ? 'project' : 'projects'}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </Section>
  ) : (
    products.length > 0 && (
      <Section id="work" eyebrow="Work" title="Built for someone else.">
        {/*
          Composed rather than apologetic. The section stays, because the
          distinction between a product and a commission is the argument the
          site is making — leaving a hole in it would be the bug.
        */}
        <div class="pointer" data-reveal>
          <p class="pointer__body">
            No client work has been approved for publication yet. That is a publishing decision
            rather than an absence of work, and we would rather say so than show you a portfolio
            full of things that do not exist.
          </p>
          <p class="pointer__body">
            Everything we have built so far, we built for ourselves — including the software running
            this site.
          </p>
          <p>
            <a class="btn btn--quiet" href="/work">
              Read the whole explanation
              <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </Section>
    )
  )}

  {shownServices.length > 0 && (
    <Section
      id="services"
      eyebrow="Services"
      title="What we build."
      note={content.servicesIntro ?? 'Ranges are published, not negotiable down.'}
    >
      <div class="services-table">
        {shownServices.map((service, i) => (
          <article class="services-table__row" data-reveal>
            <p class="services-table__index" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="services-table__name">
              <a href={`/services/${service.slug}`}>{service.name}</a>
            </h3>
            <p class="services-table__outcome">{service.outcome}</p>
            <p class="services-table__price">
              {service.priceFrom && service.priceTo
                ? `${studio.priceCurrency} ${service.priceFrom} – ${studio.priceCurrency} ${service.priceTo}`
                : (service.engagement ?? '')}
            </p>
          </article>
        ))}
      </div>

      <p class="section__more">
        <a class="btn btn--quiet" href="/services">
          Everything we do, with ranges
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </Section>
  )}

  {content.process.length > 0 && (
    <Section
      id="process"
      eyebrow="Process"
      title="How a project runs."
      note="Written down before the build, so there is nothing to renegotiate later."
    >
      <ol class="steps">
        {content.process.slice(0, 4).map((step, i) => (
          <li class="step" data-reveal>
            <p class="step__index">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="step__name">{step.phase}</h3>
            <p class="step__detail">{step.detail}</p>
          </li>
        ))}
      </ol>

      <p class="section__more">
        <a class="btn btn--quiet" href="/services#process">
          The full process
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </Section>
  )}

  {differentiators.length > 0 && (
    <Section
      id="practices"
      eyebrow="Practices"
      title="Six things that are true here."
      note="Not a list of virtues. Each one is a practice you can hold us to."
    >
      <dl class="statements">
        {differentiators.map((item) => (
          <div class="statement" data-reveal>
            <dt class="statement__label">{item.label}</dt>
            <dd class="statement__body">{item.body}</dd>
          </div>
        ))}
      </dl>
    </Section>
  )}

  {content.capabilities.length > 0 && (
    <Section id="stack" eyebrow="Stack" title="What we work in.">
      <div class="stack">
        {content.capabilities.map((group) => (
          <div class="stack__group" data-reveal>
            <h3 class="stack__name">{group.group}</h3>
            <ul class="stack__items">
              {group.items.map((entry) => (
                <li>{entry}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </Section>
  )}

  {HOME_FAQ.length > 0 && (
    <Section id="faq" eyebrow="Questions" title="Answered before you have to ask.">
      <!--
        Open by default. The section promises answers before you have to ask, and a
        collapsed answer is an answer you still have to ask for. The marker stays as
        an optional collapse for someone scanning — not as the mechanism that
        delivers the content.
      -->
      <div class="faq">
        {HOME_FAQ.map((entry) => (
          <details class="faq__item" open data-reveal>
            <summary class="faq__q">{entry.question}</summary>
            <div class="faq__a prose">
              <p>{entry.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <p class="section__more">
        <a class="btn btn--quiet" href="/about#faq">
          Every question
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </Section>
  )}

  <section class="section closing">
    <div class="shell">
      <p class="closing__line">{studio.closing}</p>
      <p class="closing__sub">
        {
          content.contactBlurb ||
            'Describe the problem, the timeline and the budget range. We reply to everything.'
        }
      </p>
      <p>
        <a class="btn btn--primary" href="/contact">
          {content.contactBlurb ? 'Describe the problem' : 'Get in touch'}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>
</Base>
