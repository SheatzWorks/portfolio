---
/**
 * Admin dashboard: projects, ordering, publish state, preview regeneration.
 *
 * Everything is rendered server-side and mutated over the authenticated API.
 * There is no client framework; the page is a form and a table, which keeps the
 * admin's JavaScript trivial and means it works even if the bundle fails.
 */
import { getEnv, getDb } from '~/lib/env';
import { listAllProjects, readFallback } from '~/lib/db';
import type { D1Database } from '@cloudflare/workers-types';

export const prerender = false;

const env = await getEnv();
const db: D1Database = getDb(env);

const projects = await listAllProjects(db as never).catch(
  readFallback('admin.projects', [] as Awaited<ReturnType<typeof listAllProjects>>),
);

let jobCounts: { pending: number; failed: number } = { pending: 0, failed: 0 };
try {
  const row = await db
    .prepare(
      `SELECT
         SUM(CASE WHEN state = 'pending' THEN 1 ELSE 0 END) AS pending,
         SUM(CASE WHEN state = 'failed'  THEN 1 ELSE 0 END) AS failed
       FROM jobs`,
    )
    .bind()
    .first<{ pending: number | null; failed: number | null }>();
  jobCounts = { pending: row?.pending ?? 0, failed: row?.failed ?? 0 };
} catch {
  /* counts are decorative */
}

// The latest enquiries, newest first. Contact-form traffic has no other
// dashboard, so this panel is where a lead survives a mail outage.
// `delivered` is set by the contact endpoint at the moment of a successful
// send; 0 is also the honest state when email is not configured.
type AdminEnquiryRow = {
  id: number;
  name: string;
  email: string;
  company: string | null;
  project_type: string | null;
  budget: string | null;
  timeline: string | null;
  message: string;
  delivered: number;
  created_at: string;
};
type AdminEnquiry = {
  id: number;
  name: string;
  email: string;
  company: string | null;
  projectType: string | null;
  budget: string | null;
  timeline: string | null;
  message: string;
  delivered: boolean;
  createdAt: string;
};
const enquiries: AdminEnquiry[] = await db
  .prepare(
    `SELECT id, name, email, company, project_type, budget, timeline, message, delivered, created_at
     FROM enquiries
     ORDER BY id DESC
     LIMIT 20`,
  )
  .all<AdminEnquiryRow>()
  .then(({ results }) =>
    results.map((row) => ({
      id: row.id,
      name: row.name,
      email: row.email,
      company: row.company,
      projectType: row.project_type,
      budget: row.budget,
      timeline: row.timeline,
      message: row.message,
      delivered: row.delivered === 1,
      createdAt: row.created_at.replace('T', ' ').slice(0, 16),
    })),
  )
  .catch(() => [] as AdminEnquiry[]);

const provider = env.CAPTURE_PROVIDER ?? 'none';
const previewMode = env.PREVIEW_FETCH_MODE ?? 'egress';
const allowlist = (env.ALLOWED_CAPTURE_HOSTS ?? '').split(',').filter((s) => s.trim()).length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin</title>
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>
    <div class="shell">
      <div class="bar">
        <div>
          <h1>Projects &amp; products</h1>
          <p class="bar__meta">
            {projects.length} total · {projects.filter((p) => p.published).length} published ·
            {jobCounts.pending} jobs queued · {jobCounts.failed} failed
          </p>
        </div>
        <div class="bar__actions">
          <a class="btn" href="/" target="_blank" rel="noopener">View site</a>
          <form method="post" action="/api/admin/session" data-signout class="signout-form">
            <button class="btn" type="submit">Sign out</button>
          </form>
        </div>
      </div>

      <p class="bar__meta config-line">
        capture provider: <strong>{provider}</strong> · fetch mode: <strong>{previewMode}</strong> ·
        host allowlist: <strong>{allowlist === 0 ? 'none (relies on SSRF filtering)' : `${allowlist} host(s)`}</strong>
      </p>

      <!-- ------------------------------------------------------------ add -->
      <h2 class="section-title">Add a project</h2>
      <div class="card">
        <form id="add-form" class="form-grid">
          <p class="hint hint--flush">
            A URL is the only required field. Title, description and the social image are read
            from the page automatically; the capture is queued and finishes in the background.
          </p>

          <div class="field">
            <label for="add-url">Project URL *</label>
            <input id="add-url" name="url" type="url" placeholder="https://example.netlify.app" required />
          </div>

          <div class="form-grid form-grid--2">
            <div class="field">
              <label for="add-title">Title</label>
              <input id="add-title" name="title" type="text" placeholder="Read from the page if blank" />
            </div>
            <div class="field">
              <label for="add-blurb">One-line description</label>
              <input id="add-blurb" name="blurb" type="text" placeholder="Shown on the card" />
            </div>
          </div>

          <div class="form-grid form-grid--2">
            <div class="field">
              <label for="add-ownership">Ownership</label>
              {/*
                This one field decides which page the item appears on, so it is
                the first discriminator in the form rather than a detail.
              */}
              <select id="add-ownership" name="ownership">
                <option value="client">Client work — someone commissioned it</option>
                <option value="own">Own product — we built and run it</option>
              </select>
            </div>

            <div class="field">
              <label for="add-kind">Type</label>
              <select id="add-kind" name="kind">
                <option value="web">Website</option>
                <option value="webapp">Web application</option>
                <option value="mobile">Mobile app</option>
                <option value="saas">SaaS</option>
                <option value="ai">AI</option>
                <option value="experiment">Experiment</option>
                <option value="client">Client work</option>
                <option value="internal">Internal</option>
              </select>
            </div>
            <div class="field">
              <label for="add-product-status">Product state</label>
              <select id="add-product-status" name="product_status">
                <option value="">Not a product</option>
                <option value="planning">Planned</option>
                <option value="in-development">In development</option>
                <option value="beta">Beta</option>
                <option value="live">Live</option>
                <option value="paused">Paused</option>
                <option value="retired">Retired</option>
              </select>
              <p class="hint">Published as a stated fact. Only applies to own products.</p>
            </div>

            <div class="field">
              <label for="add-tagline">Product one-liner</label>
              <input id="add-tagline" name="tagline" type="text" placeholder="What it is, and what state it is in" />
            </div>

            <div class="field">
              <label for="add-year">Year</label>
              <input id="add-year" name="year" type="number" min="1990" max="2100" placeholder="2026" />
            </div>

            <div class="field">
              <label for="add-availability">Live link</label>
              <input id="add-availability" name="availability_url" type="url" placeholder="https://app.example.com" />
              <span class="hint">Where the card's Open button goes. Falls back to the URL above.</span>
            </div>
          </div>

          <div class="field">
            <label for="add-summary">Longer description</label>
            <textarea id="add-summary" name="summary" placeholder="Two or three sentences: what it does, who it is for"></textarea>
            <span class="hint">Expanded under the one-liner on the card. If the one-liner is blank, this becomes the card text.</span>
          </div>

          <div class="field">
            <label for="add-tech">Technologies</label>
            <input id="add-tech" name="technologies" type="text" placeholder="Astro, TypeScript, D1" />
            <span class="hint">Comma separated. Shown as tags on the card.</span>
          </div>

          <div class="form-grid form-grid--2">
            <div class="field">
              <label for="add-ar">Media ratio</label>
              <select id="add-ar" name="aspect_ratio">
                <option value="1.7778">16:9 landscape</option>
                <option value="1.5">3:2 landscape</option>
                <option value="1.3333">4:3 landscape</option>
                <option value="1" selected>Square</option>
                <option value="0.8">4:5 portrait</option>
              </select>
            </div>
            <div class="field">
              <label for="add-github">Source repository</label>
              <input id="add-github" name="github" type="url" placeholder="https://github.com/..." />
            </div>
          </div>

          <div class="form-grid form-grid--2">
            <div class="field">
              <label class="check" for="add-featured"><input type="checkbox" id="add-featured" name="featured" /> Feature on the home page</label>
            </div>
            <div class="field">
              <label class="check" for="add-published"><input type="checkbox" id="add-published" name="published" checked /> Publish immediately</label>
            </div>
          </div>

          <div>
            <button class="btn btn--primary" type="submit" data-submit>Add project</button>
          </div>

          <p class="status" data-status role="status" aria-live="polite" hidden></p>
        </form>
      </div>

      <!-- ------------------------------------------------------ enquiries -->
      <h2 class="section-title">Recent enquiries</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Received</th>
              <th>From</th>
              <th>About</th>
              <th>Message</th>
              <th>Email</th>
            </tr>
          </thead>
          <tbody>
            {
              enquiries.length === 0 ? (
                <tr class="empty-row">
                  <td colspan={5}>No enquiries yet. When the contact form is used, they appear here.</td>
                </tr>
              ) : (
                enquiries.map((e) => (
                  <tr>
                    <td class="mono">{e.createdAt}</td>
                    <td>
                      <strong class="row-title">{e.name}</strong>
                      {e.company && (
                        <>
                          <br />
                          <span class="mono">{e.company}</span>
                        </>
                      )}
                    </td>
                    <td>
                      {e.projectType && (
                        <>
                          <span class="mono">{e.projectType}</span>
                          <br />
                        </>
                      )}
                      {e.budget && <span class="mono">{e.budget}</span>}
                      {e.budget && e.timeline && <br />}
                      {e.timeline && <span class="mono">{e.timeline}</span>}
                    </td>
                    <td class="enquiry-msg">{e.message}</td>
                    <td>
                      <span class="badge" data-on={String(e.delivered)}>
                        {e.delivered ? 'emailed' : 'stored'}
                      </span>
                      <br />
                      <a class="mono" href={`mailto:${e.email}`}>{e.email}</a>
                    </td>
                  </tr>
                ))
              )
            }
          </tbody>
        </table>
      </div>

      <!-- ---------------------------------------------------------- list -->
      <h2 class="section-title">All projects</h2>
      <div class="table-wrap">
        <table data-table>
          <thead>
            <tr>
              <th>Order</th>
              <th>Title</th>
              <th>Route</th>
              <th>Preview</th>
              <th>Flags</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody data-rows>
            {
              projects.length === 0 ? (
                <tr class="empty-row">
                  <td colspan={6}>
                    Nothing here yet. Add a project above — a URL is all that is required.
                  </td>
                </tr>
              ) : (
                projects.map((p) => (
                  <>
                  <tr data-id={p.id} data-slug={p.slug}>
                    <td class="mono">{p.sortOrder}</td>
                    <td>
                      <strong class="row-title">{p.title}</strong>
                      <br />
                      <span class="mono">{p.url}</span>
                    </td>
                    <td>
                      <span class="badge" data-on={p.ownership === 'own' ? 'true' : undefined}>
                        {p.ownership === 'own' ? 'own product' : 'client'}
                      </span>
                      <br />
                      <span class="mono">{p.kind}</span>
                      {p.productStatus && (
                        <>
                          <br />
                          <span class="mono">{p.productStatus}</span>
                        </>
                      )}
                    </td>
                    <td>
                      <span class="badge" data-state={p.previewState}>
                        {p.previewState}
                      </span>
                      {p.preview.source && (
                        <>
                          <br />
                          <span class="mono">{p.preview.source}</span>
                        </>
                      )}
                      {p.preview.note && (
                        <>
                          <br />
                          <span class="mono">{p.preview.note}</span>
                        </>
                      )}
                    </td>
                    <td>
                      <span class="badge" data-on={String(p.published)}>
                        {p.published ? 'published' : 'draft'}
                      </span>{' '}
                      {p.featured && (
                        <span class="badge" data-on="true">
                          featured
                        </span>
                      )}{' '}
                      {p.hasCaseStudy && <span class="badge">case study</span>}
                    </td>
                    <td class="actions">
                      <button class="btn btn--sm" data-action="edit" data-id={p.id}>Edit</button>
                      <button class="btn btn--sm" data-action="toggle-published" data-id={p.id}>
                        {p.published ? 'Unpublish' : 'Publish'}
                      </button>
                      <button class="btn btn--sm" data-action="toggle-featured" data-id={p.id}>
                        {p.featured ? 'Unfeature' : 'Feature'}
                      </button>
                      <button class="btn btn--sm" data-action="regenerate" data-id={p.id} data-run="1">
                        Re-capture
                      </button>
                      <a
                        class="btn btn--sm"
                        href={`${p.ownership === 'own' ? '/products' : '/work'}/${p.slug}`}
                        target="_blank"
                        rel="noopener"
                      >
                        View
                      </a>
                      <button class="btn btn--sm" data-action="delete" data-id={p.id}>Delete</button>
                    </td>
                  </tr>
                  <tr data-edit-row hidden>
                    <td colspan={6}>
                      <div class="card">
                        <form class="form-grid" data-edit-form data-id={p.id}>
                          <div class="form-grid form-grid--2">
                            <div class="field">
                              <label for={`edit-${p.id}-title`}>Title</label>
                              <input id={`edit-${p.id}-title`} name="title" type="text" value={p.title} />
                            </div>
                            <div class="field">
                              <label for={`edit-${p.id}-url`}>URL</label>
                              <input id={`edit-${p.id}-url`} name="url" type="url" value={p.url} />
                            </div>
                            <div class="field">
                              <label for={`edit-${p.id}-blurb`}>One-line description</label>
                              <input id={`edit-${p.id}-blurb`} name="blurb" type="text" value={p.blurb ?? ''} />
                            </div>
                            <div class="field">
                              <label for={`edit-${p.id}-tagline`}>Product one-liner</label>
                              <input id={`edit-${p.id}-tagline`} name="tagline" type="text" value={p.tagline ?? ''} />
                            </div>
                            <div class="field">
                              <label for={`edit-${p.id}-availability`}>Live link</label>
                              <input
                                id={`edit-${p.id}-availability`}
                                name="availability_url"
                                type="url"
                                value={p.availabilityUrl ?? ''}
                                placeholder="Falls back to the URL above"
                              />
                            </div>
                            <div class="field">
                              <label for={`edit-${p.id}-year`}>Year</label>
                              <input
                                id={`edit-${p.id}-year`}
                                name="year"
                                type="number"
                                min="1990"
                                max="2100"
                                value={p.year ?? ''}
                              />
                            </div>
                            <div class="field">
                              <label for={`edit-${p.id}-tech`}>Technologies</label>
                              <input
                                id={`edit-${p.id}-tech`}
                                name="technologies"
                                type="text"
                                value={p.technologies.join(', ')}
                              />
                            </div>
                            <div class="field">
                              <label for={`edit-${p.id}-github`}>Source repository</label>
                              <input id={`edit-${p.id}-github`} name="github" type="url" value={p.links.github ?? ''} />
                            </div>
                            <div class="field">
                              <label for={`edit-${p.id}-ownership`}>Ownership</label>
                              <select id={`edit-${p.id}-ownership`} name="ownership">
                                <option value="client" selected={p.ownership === 'client'}>
                                  Client work — someone commissioned it
                                </option>
                                <option value="own" selected={p.ownership === 'own'}>
                                  Own product — we built and run it
                                </option>
                              </select>
                            </div>
                            <div class="field">
                              <label for={`edit-${p.id}-status`}>Product state</label>
                              <select id={`edit-${p.id}-status`} name="product_status">
                                <option value="" selected={!p.productStatus}>Not a product</option>
                                <option value="planning" selected={p.productStatus === 'planning'}>Planned</option>
                                <option value="in-development" selected={p.productStatus === 'in-development'}>
                                  In development
                                </option>
                                <option value="beta" selected={p.productStatus === 'beta'}>Beta</option>
                                <option value="live" selected={p.productStatus === 'live'}>Live</option>
                                <option value="paused" selected={p.productStatus === 'paused'}>Paused</option>
                                <option value="retired" selected={p.productStatus === 'retired'}>Retired</option>
                              </select>
                            </div>
                            <div class="field">
                              <label for={`edit-${p.id}-order`}>Order</label>
                              <input id={`edit-${p.id}-order`} name="sort_order" type="number" step="1" value={p.sortOrder} />
                            </div>
                          </div>

                          <div class="field">
                            <label for={`edit-${p.id}-summary`}>Longer description</label>
                            <textarea id={`edit-${p.id}-summary`} name="summary">{p.summary ?? ''}</textarea>
                            <span class="hint">
                              Expanded under the one-liner on the card. If the one-liner is blank, this becomes the
                              card text.
                            </span>
                          </div>

                          <div class="edit-actions">
                            <button class="btn btn--primary" type="submit" data-save>Save changes</button>
                            <button class="btn" type="button" data-action="cancel-edit">Cancel</button>
                          </div>

                          <p class="status" data-edit-status role="status" aria-live="polite" hidden></p>
                        </form>
                      </div>
                    </td>
                  </tr>
                  </>
                ))
              )
            }
          </tbody>
        </table>
      </div>
    </div>

    <script>
      async function call(action: string, body: Record<string, unknown>) {
        const response = await fetch(`/api/admin/projects?action=${encodeURIComponent(action)}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(body),
        });
        type AdminResponse = { ok: boolean; error?: string; [key: string]: unknown };
        const data = (await response.json().catch(() => ({}))) as AdminResponse;
        if (!response.ok || data.ok === false) {
          throw new Error(data.error ?? `Request failed (${response.status})`);
        }
        return data;
      }

      // ---- add form ----------------------------------------------------
      const form = document.getElementById('add-form') as HTMLFormElement | null;
      const statusEl = document.querySelector<HTMLElement>('[data-status]');
      const setStatus = (message: string, state: 'ok' | 'error') => {
        if (!statusEl) return;
        statusEl.textContent = message;
        statusEl.dataset.state = state;
        statusEl.hidden = false;
      };

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
        if (submit) {
          submit.disabled = true;
          submit.textContent = 'Adding…';
        }
        const fd = new FormData(form);
        try {
          const result = await call('create', {
            url: String(fd.get('url') ?? ''),
            title: String(fd.get('title') ?? ''),
            blurb: String(fd.get('blurb') ?? ''),
            ownership: String(fd.get('ownership') ?? 'client'),
            product_status: String(fd.get('product_status') ?? ''),
            tagline: String(fd.get('tagline') ?? ''),
            summary: String(fd.get('summary') ?? ''),
            availability_url: String(fd.get('availability_url') ?? ''),
            kind: String(fd.get('kind') ?? 'web'),
            year: String(fd.get('year') ?? ''),
            technologies: String(fd.get('technologies') ?? ''),
            aspect_ratio: Number(fd.get('aspect_ratio') ?? 1),
            github: String(fd.get('github') ?? ''),
            featured: fd.get('featured') === 'on',
            published: fd.get('published') === 'on',
          });
          setStatus(`Added "${result.slug}". Reloading…`, 'ok');
          setTimeout(() => location.reload(), 600);
        } catch (err) {
          setStatus(err instanceof Error ? err.message : 'Could not add the project.', 'error');
          if (submit) {
            submit.disabled = false;
            submit.textContent = 'Add project';
          }
        }
      });

      // ---- sign out ----------------------------------------------------
      // A plain form POST hits the LOGIN handler, which would just bounce back
      // to the login page with the session intact. DELETE is the sign-out verb,
      // and a method override carries it from a form that cannot issue one.
      document.querySelector<HTMLFormElement>('[data-signout]')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        fetch(form.action, { method: 'DELETE', credentials: 'same-origin' }).finally(() => {
          location.href = '/admin/login';
        });
      });

      // ---- row actions -------------------------------------------------
      document.addEventListener('click', async (event) => {
        const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-action]');
        if (!button) return;

        const action = button.dataset.action!;
        const id = Number(button.dataset.id);

        if (action === 'edit') {
          const editRow = button.closest('tr')?.nextElementSibling;
          if (editRow?.hasAttribute('data-edit-row')) {
            const opening = editRow.hasAttribute('hidden');
            if (opening) {
              // Only one editor open at a time; the rows are siblings, so the
              // trigger button of any other open row is two elements back.
              document.querySelectorAll('[data-edit-row]').forEach((other) => {
                if (other === editRow) return;
                other.setAttribute('hidden', '');
                const trigger = other.previousElementSibling?.querySelector('[data-action="edit"]');
                if (trigger) trigger.textContent = 'Edit';
              });
              editRow.removeAttribute('hidden');
              button.textContent = 'Close';
              editRow.querySelector<HTMLInputElement>('input[name="title"]')?.focus();
            } else {
              editRow.setAttribute('hidden', '');
              button.textContent = 'Edit';
            }
          }
          return;
        }

        if (action === 'cancel-edit') {
          const editRow = button.closest('[data-edit-row]');
          if (editRow) {
            editRow.setAttribute('hidden', '');
            const trigger = editRow.previousElementSibling?.querySelector('[data-action="edit"]');
            if (trigger) trigger.textContent = 'Edit';
          }
          return;
        }

        if (action === 'delete') {
          const slug = button.closest('tr')?.dataset.slug ?? 'this project';
          if (!confirm(`Delete "${slug}"? This also removes its queued capture jobs.`)) return;
        }

        const original = button.textContent;
        button.disabled = true;
        button.textContent = '…';

        try {
          await call(action, { id, run: button.dataset.run === '1' });
          location.reload();
        } catch (err) {
          alert(err instanceof Error ? err.message : 'Request failed.');
          button.disabled = false;
          button.textContent = original;
        }
      });

      // ---- edit form ---------------------------------------------------
      // Delegated rather than one listener per row: the rows come and go with
      // every reload, and the edit forms are rendered server-side.
      document.addEventListener('submit', (event) => {
        const form = (event.target as HTMLElement | null)?.closest<HTMLFormElement>('[data-edit-form]');
        if (!form) return;
        event.preventDefault();

        const save = form.querySelector<HTMLButtonElement>('[data-save]');
        const status = form.querySelector<HTMLElement>('[data-edit-status]');
        const setStatus = (message: string, state: 'ok' | 'error') => {
          if (!status) return;
          status.textContent = message;
          status.dataset.state = state;
          status.hidden = false;
        };

        const fd = new FormData(form);
        if (save) {
          save.disabled = true;
          save.textContent = 'Saving…';
        }

        call('update', {
          id: Number(form.dataset.id),
          title: String(fd.get('title') ?? ''),
          url: String(fd.get('url') ?? ''),
          blurb: String(fd.get('blurb') ?? ''),
          tagline: String(fd.get('tagline') ?? ''),
          summary: String(fd.get('summary') ?? ''),
          ownership: String(fd.get('ownership') ?? 'client'),
          product_status: String(fd.get('product_status') ?? ''),
          availability_url: String(fd.get('availability_url') ?? ''),
          year: String(fd.get('year') ?? ''),
          technologies: String(fd.get('technologies') ?? ''),
          github: String(fd.get('github') ?? ''),
          sort_order: String(fd.get('sort_order') ?? ''),
        })
          .then(() => {
            setStatus('Saved. Reloading…', 'ok');
            setTimeout(() => location.reload(), 500);
          })
          .catch((err: unknown) => {
            setStatus(err instanceof Error ? err.message : 'Could not save the changes.', 'error');
            if (save) {
              save.disabled = false;
              save.textContent = 'Save changes';
            }
          });
      });
    </script>
  </body>
</html>
