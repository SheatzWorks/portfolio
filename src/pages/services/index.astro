---
/**
 * /services — what the studio builds, and what it costs.
 *
 * Prices are published. It is the least common thing on a studio site and the
 * most useful, because it sorts out a mismatched enquiry before either side
 * spends a call on it. Every range carries its qualifier — scope, currency and
 * what it does not cover — because a bare number is a promise nobody can keep.
 *
 * Signature services are the ones the studio actually wants to be hired for,
 * and they are listed first. The rest are things it will also do well.
 */
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import { studio } from '~/config/site';
import { getEnv, hasDb } from '~/lib/env';
import { listServices, getSiteContent } from '~/lib/db';
import type { Service } from '~/lib/types';

export const prerender = false;

const env = await getEnv(Astro.locals);

let services: Service[] = [];
let intro = '';
let process: { phase: string; detail: string }[] = [];
let capabilities: { group: string; items: string[] }[] = [];

if (hasDb(env)) {
  const db = env.DB as never;
  const content = await getSiteContent(db);
  [services, process, capabilities, intro] = [
    await listServices(db),
    content.process ?? [],
    content.capabilities ?? [],
    content.servicesIntro ?? '',
  ];
}

const signature = services.filter((s) => s.isSignature);
const alsoDo = services.filter((s) => !s.isSignature);

/**
 * The range with its currency attached.
 *
 * The currency is stated once per number rather than as a page-level footnote,
 * because a reader comparing two services should never have to remember which
 * unit they are in.
 */
function priceRange(service: Service): string | null {
  if (service.priceFrom && service.priceTo) {
    return `${studio.priceCurrency} ${service.priceFrom} – ${studio.priceCurrency} ${service.priceTo}`;
  }
  return null;
}
---

<Base title="Services" description="What sheatz builds and what it costs. Published price ranges for web applications, mobile apps, AI products, websites, automation and design systems.">
  <section class="page-head">
    <div class="shell">
      <p class="eyebrow eyebrow--plain">Services</p>
      <h1 class="page-head__title">What we build, and what it costs.</h1>
      <p class="page-head__lede">
        {
          intro ||
            'Ranges, not hourly rates. You know roughly what a project costs before you write to us, and we can both find out quickly if we are a fit.'
        }
      </p>
    </div>
  </section>

  {
    signature.length > 0 && (
      <section class="section" aria-labelledby="signature-services">
        <div class="shell">
          <header class="section-head" data-reveal>
            <div class="section-head__kicker">
              <p class="section-head__index" aria-hidden="true"></p>
              <p class="eyebrow eyebrow--plain">Signature</p>
            </div>
            <div class="section-head__row">
              <h2 class="section-head__title" id="signature-services">
                What we would like to be hired for.
              </h2>
            </div>
          </header>

          <div class="pricing">
            {signature.map((service) => (
              <article class="price" data-reveal>
                <div class="price__head">
                  <h3 class="price__name">
                    <a href={`/services/${service.slug}`}>{service.name}</a>
                  </h3>
                  {service.engagement && <p class="price__engagement">{service.engagement}</p>}
                </div>

                <p class="price__outcome">{service.outcome}</p>

                <div class="price__foot">
                  <p class="price__amount">
                    {priceRange(service) ? (
                      <>
                        <span class="price__from">
                          <span class="price__unit">{studio.priceCurrency}</span>
                          {service.priceFrom}
                        </span>
                        <span class="price__to">
                          <span class="price__unit">{studio.priceCurrency}</span>
                          {service.priceTo}
                        </span>
                      </>
                    ) : service.engagement ? (
                      /* No published range. The engagement label is the real
                         record; without it there is nothing truthful to print
                         and the row is left out rather than guessed. */
                      <span class="price__custom">{service.engagement}</span>
                    ) : null}
                  </p>
                  {service.priceNote && <p class="price__note">{service.priceNote}</p>}
                </div>

                {service.deliverables.length > 0 && (
                  <ul class="price__includes">
                    {service.deliverables.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    alsoDo.length > 0 && (
      <Section
        id="other-services"
        eyebrow="Also"
        title="Things we will also do properly."
        note="Not the reason to get in touch, but work we are happy to take on."
      >
        <div class="services-table">
          {alsoDo.map((service, i) => (
            <article class="services-table__row">
              <p class="services-table__index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="services-table__name">
                <a href={`/services/${service.slug}`}>{service.name}</a>
              </h3>
              <p class="services-table__outcome">{service.outcome}</p>
              <p class="services-table__price">
                {priceRange(service) ?? (service.engagement ?? '')}
              </p>
            </article>
          ))}
        </div>
      </Section>
    )
  }

  {
    process.length > 0 && (
      <Section
        id="process"
        eyebrow="Process"
        title="How a project runs."
        note="Written down before we start, so there is nothing to negotiate later."
      >
        <ol class="steps">
          {process.map((step, i) => (
            <li class="step" data-reveal>
              <p class="step__index">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="step__name">{step.phase}</h3>
              <p class="step__detail">{step.detail}</p>
            </li>
          ))}
        </ol>
      </Section>
    )
  }

  {
    capabilities.length > 0 && (
      <Section id="stack" eyebrow="Stack" title="What we work in.">
        <div class="stack">
          {capabilities.map((group) => (
            <div class="stack__group" data-reveal>
              <h3 class="stack__name">{group.group}</h3>
              <ul class="stack__items">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </Section>
    )
  }

  <Section id="services-cta" eyebrow="Next" title="If the scope is bigger than a range">
    <p class="lede">
      Ranges cover ordinary projects. Some work is genuinely unusual and does not fit one, and the
      honest answer then is a conversation rather than a number.
    </p>
    <p>
      <a class="btn btn--primary" href="/contact">
        Describe the problem
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </p>
  </Section>
</Base>
