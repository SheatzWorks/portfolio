---
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import { studio, publishableSocial, publishableEmail } from '~/config/site';
import { getEnv } from '~/lib/env';
import { getSiteContent } from '~/lib/db';

export const prerender = true;

const env = await getEnv(Astro.locals);
let blurb: string | null = null;
if (env.DB) {
  blurb = (await getSiteContent(env.DB as never).catch(() => null))?.contactBlurb ?? null;
}

// Rendered at build time into a hidden field. A submission that arrives faster
// than MIN_FILL_MS is dropped before it can cost a Turnstile verification.
const renderedAt = Date.now();
const turnstileSiteKey = env.TURNSTILE_SITE_KEY;
---

<Base
  title={`Contact — ${studio.name}`}
  description={`Start a project with ${studio.name}. Send a short brief with a timeline and budget range, and we reply with a straight answer.`}
  canonicalPath="/contact"
>
  <Section id="contact" eyebrow="Contact" title="Tell us what you are building" headingLevel={1}>
    <div class="contact">
      <div class="contact__form">
        <form class="form" method="post" action="/api/contact" data-contact-form novalidate>
          <p class="lede">
            {
              blurb ??
                "A sentence about the project, a rough timeline and a budget range is enough for us to say whether it's a fit."
            }
          </p>

          <div class="form__row form__row--2">
            <div class="field">
              <label class="field__label" for="name">
                Name <span class="req" aria-hidden="true">*</span>
              </label>
              <input
                class="input"
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                maxlength="120"
                aria-describedby="name-error"
              />
              <p class="field__error" id="name-error" data-error-for="name" role="alert"></p>
            </div>

            <div class="field">
              <label class="field__label" for="email">
                Email <span class="req" aria-hidden="true">*</span>
              </label>
              <input
                class="input"
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                maxlength="200"
                aria-describedby="email-error"
              />
              <p class="field__error" id="email-error" data-error-for="email" role="alert"></p>
            </div>
          </div>

          <div class="form__row form__row--2">
            <div class="field">
              <label class="field__label" for="company">Company or site</label>
              <input
                class="input"
                id="company"
                name="company"
                type="text"
                autocomplete="organization"
                maxlength="200"
              />
            </div>

            <div class="field">
              <label class="field__label" for="project_type">Project type</label>
              <select class="select" id="project_type" name="project_type">
                <option value="">Not sure yet</option>
                <option value="website">Website</option>
                <option value="webapp">Web application</option>
                <option value="saas">SaaS or product</option>
                <option value="mobile">Mobile app</option>
                <option value="ai">AI integration</option>
                <option value="automation">Automation</option>
                <option value="redesign">Redesign or rebuild</option>
                <option value="other">Something else</option>
              </select>
            </div>
          </div>

          <div class="form__row form__row--2">
            <div class="field">
              <label class="field__label" for="timeline">Timeline</label>
              <select class="select" id="timeline" name="timeline">
                <option value="">Flexible</option>
                <option value="asap">As soon as possible</option>
                <option value="month">Within a month</option>
                <option value="quarter">This quarter</option>
                <option value="later">Later this year</option>
                <option value="exploring">Just exploring</option>
              </select>
            </div>

            <div class="field">
              <label class="field__label" for="budget">Budget range</label>
              <select class="select" id="budget" name="budget">
                <option value="">Prefer not to say</option>
                <option value="under-5k">Under 5,000</option>
                <option value="5k-15k">5,000 - 15,000</option>
                <option value="15k-40k">15,000 - 40,000</option>
                <option value="40k-plus">40,000+</option>
                <option value="retainer">Ongoing / retainer</option>
              </select>
              <p class="field__hint">A range is enough. It tells us how to scope, not whether we are interested.</p>
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="message">
              What are you building? <span class="req" aria-hidden="true">*</span>
            </label>
            <textarea
              class="textarea"
              id="message"
              name="message"
              required
              maxlength="5000"
              aria-describedby="message-error message-hint"></textarea>
            <p class="field__hint" id="message-hint">
              What it does, who it is for, and anything already built. Links help.
            </p>
            <p class="field__error" id="message-error" data-error-for="message" role="alert"></p>
          </div>

          {/* Honeypot. Off-screen rather than display:none so naive bots fill it. */}
          <div class="hp" aria-hidden="true">
            <label for="company_website">Leave this field empty</label>
            <input id="company_website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <input type="hidden" name="rendered_at" value={renderedAt} />

          {
            turnstileSiteKey && (
              <div
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-theme="light"
              />
            )
          }

          <p class="form__status" data-form-status role="status" aria-live="polite" hidden></p>

          {/*
            The submit row and the privacy note share one line: the note is
            the button's caption, not a paragraph of its own, and on a
            one-screen contact page that distinction is worth 65px.
          */}
          <div class="form__foot">
            <button class="btn btn--primary" type="submit" data-submit>
              Send it
            </button>
            <p class="field__hint">
              We use your details only to reply to this enquiry. Nothing is added to a
              mailing list or shared. See the <a href="/privacy">privacy note</a>.
            </p>
          </div>
        </form>
      </div>

      <aside class="contact__aside">
        {publishableEmail() ? (
          <>
            <h2 class="contact__aside-heading">Or reach us directly</h2>
            <a
              class="copy-email"
              href={`mailto:${publishableEmail()}`}
              data-copy-email
              title="Copy email address"
            >
              <span>{publishableEmail()}</span>
              <span class="copy-email__state" data-copy-state aria-live="polite"></span>
            </a>
          </>
        ) : (
          <p class="contact__aside-note">
            The form is the fastest way to reach us — it lands with the studio
            directly, and everything below is what happens to it.
          </p>
        )}

        {/*
          Rendered only when there is somewhere to go. An "Elsewhere" heading
          above an empty list is the same defect as the placeholder links it
          replaced.
        */}
        {publishableSocial().length > 0 && (
          <>
            <h2 class="contact__aside-heading">Elsewhere</h2>
            <ul class="team__links contact__social">
              {
                publishableSocial()
                  .map((s) => (
                  <li>
                    <a href={s.href} target="_blank" rel="noopener noreferrer">
                      {s.label}
                      {s.handle ? ` ${s.handle}` : ''}
                    </a>
                  </li>
                ))
              }
            </ul>
          </>
        )}

        <h2 class="contact__aside-heading">What happens next</h2>
        <ol class="contact__next list-none">
          <li><span class="process__marker" aria-hidden="true"></span>We read it and reply, usually within a couple of days.</li>
          <li><span class="process__marker" aria-hidden="true"></span>If it looks like a fit we set up a short call.</li>
          <li><span class="process__marker" aria-hidden="true"></span>You get a written scope and a fixed price.</li>
        </ol>
      </aside>
    </div>
  </Section>
</Base>

<script>
  function init() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');

    const setStatus = (message: string, state: 'success' | 'error') => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
      status.hidden = false;
    };

    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => (el.textContent = ''));
      form.querySelectorAll<HTMLElement>('[aria-invalid]').forEach((el) =>
        el.removeAttribute('aria-invalid'),
      );
    };

    const showErrors = (errors: Record<string, string> | undefined) => {
      if (!errors) return;
      for (const [field, message] of Object.entries(errors)) {
        const slot = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
        if (slot) slot.textContent = message;
        const input = form.querySelector<HTMLElement>(`[name="${field}"]`);
        input?.setAttribute('aria-invalid', 'true');
      }
      // Move focus to the first invalid field so keyboard users are not hunting.
      const first = form.querySelector<HTMLElement>('[aria-invalid="true"]');
      first?.focus();
    };

    /*
     * Turnstile. The widget script is injected only when a site key is
     * configured; without one the form relies on the honeypot, the fill-time
     * check and the per-IP rate limit, and none of this runs.
     *
     * The submit handler below AWAITS the token. Loading the widget is async,
     * so a fast tap on "Send it" would otherwise post an empty
     * cf-turnstile-response and be rejected with a spurious 403.
     */
    const turnstileEl = form.querySelector<HTMLElement>('.cf-turnstile');

    if (turnstileEl) {
      type TurnstileApi = { render: (el: HTMLElement, opts: Record<string, unknown>) => void };
      type TsWindow = Window & { __turnstileLoading?: Promise<TurnstileApi | null> };

      /*
       * Explicit render, loaded once per document.
       *
       * The old code injected the auto-render script and then assigned
       * `studioTurnstileCallback` to a function that called itself — infinite
       * recursion on the first successful challenge. There was also no guard
       * on the script, so a client-side navigation re-created the widget div
       * without anything to render it.
       */
      const w = window as TsWindow;
      const loaded =
        w.__turnstileLoading ??
        (w.__turnstileLoading = new Promise<TurnstileApi | null>((resolve) => {
          const script = document.createElement('script');
          script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
          script.async = true;
          script.defer = true;
          script.onload = () =>
            resolve((window as unknown as { turnstile?: TurnstileApi }).turnstile ?? null);
          script.onerror = () => {
            // The widget is unreachable. Continue with the other three layers
            // rather than making the form permanently unusable.
            resolve(null);
          };
          document.head.appendChild(script);
          // Never block on the widget: if it has not loaded in 6s, proceed.
          setTimeout(() => resolve(null), 6000);
        }));

      const sitekey = turnstileEl.dataset.sitekey ?? '';
      void loaded.then((api) => {
        if (!api || !sitekey || !turnstileEl.isConnected) return;
        try {
          api.render(turnstileEl, { sitekey, theme: 'light' });
        } catch {
          // Already rendered by an earlier pass on this element.
        }
      });

      /** Resolves once Turnstile has written a token into the form, or on timeout. */
      const awaitTurnstileToken = async () => {
        await loaded;
        const started = Date.now();
        for (;;) {
          const field = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]');
          if (field?.value || Date.now() - started > 10_000) return;
          await new Promise((r) => setTimeout(r, 150));
        }
      };

      // Attach once at init, before any submit can happen.
      void awaitTurnstileToken;
      (form as HTMLFormElement & { __awaitTurnstile?: () => Promise<void> }).__awaitTurnstile =
        awaitTurnstileToken;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      if (status) status.hidden = true;

      // Give Turnstile a chance to finish before the request goes out.
      const withTurnstile = form as HTMLFormElement & { __awaitTurnstile?: () => Promise<void> };
      await withTurnstile.__awaitTurnstile?.();

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        // The endpoint's response shape, declared once. `.json()` is typed as
        // `unknown`, so without this every property access below is an error.
        type ContactResponse = {
          ok: boolean;
          message?: string;
          error?: string;
          errors?: Record<string, string>;
        };
        const data = (await response.json().catch(() => ({}))) as ContactResponse;

        if (data.ok) {
          form.reset();
          setStatus(data.message ?? 'Thanks — your message has been sent.', 'success');
        } else {
          showErrors(data.errors);
          setStatus(data.error ?? 'Something went wrong. Please email us instead.', 'error');
        }
      } catch {
        setStatus('Could not reach the server. Please email us directly.', 'error');
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = 'Send it';
        }
      }
    });

    // Click-to-copy lives in SiteFooter, which is on every page. It used to be
    // duplicated here, so one click copied twice and raced the two handlers.
  }

  /*
   * `astro:page-load` fires on first load and after every ClientRouter swap;
   * the form is a new node each time, so the pass has to run again.
   */
  document.addEventListener('astro:page-load', init);
</script>
