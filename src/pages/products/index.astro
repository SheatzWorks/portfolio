---
/**
 * /products — software sheatz built and operates.
 *
 * Split from /work on purpose. A product and a commission are different
 * claims: one says "we made this and it runs", the other says "someone paid us
 * to make this". Rendering them in one undifferentiated grid would blur
 * exactly the distinction the site exists to make.
 *
 * Products are listed before they are finished, and their lifecycle state is
 * published. A "coming soon" placeholder hides real work; a bare launch badge
 * over unfinished software is worse. Neither.
 */
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import ProductCard from '~/components/ProductCard.astro';
import ProductsMore from '~/components/ProductsMore.astro';
import { getEnv, hasDb } from '~/lib/env';
import { listOwnProducts, listDifferentiators } from '~/lib/db';
import type { Product, Differentiator } from '~/lib/types';

export const prerender = false;

const env = await getEnv(Astro.locals);

let products: Product[] = [];
let differentiators: Differentiator[] = [];

if (hasDb(env)) {
  const db = env.DB as never;
  [products, differentiators] = await Promise.all([
    listOwnProducts(db),
    listDifferentiators(db),
  ]);
}

/** A live count is a fact about the portfolio, not decoration. */
const liveCount = products.filter((p) => p.productStatus === 'live' || p.productStatus === 'beta').length;
---

<Base title="Products" description="Software sheatz designs, builds and operates — including the products behind this site. Lifecycle state is published, including what is still in development.">
  <section class="page-head">
    <div class="shell">
      <p class="eyebrow eyebrow--plain">Products</p>
      <h1 class="page-head__title">What we build and run ourselves.</h1>
      <p class="page-head__lede">
        These are our own products. If they were commissioned work you would find them under
        <a href="/work">Work</a> instead.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="products-grid">
    <div class="shell">
      <header class="section-head" data-reveal>
        <p class="eyebrow eyebrow--plain">
          {
            products.length === 0
              ? 'Nothing published yet'
              : `${products.length} ${products.length === 1 ? 'product' : 'products'}${
                  liveCount > 0 ? ` · ${liveCount} live` : ''
                }`
          }
        </p>
        <div class="section-head__row">
          <h2 class="section-head__title" id="products-grid-title">Currently in the build</h2>
        </div>
      </header>

      {
        products.length > 0 ? (
          <div class="products">
            {products.map((product, i) => (
              <ProductCard product={product} priority={i === 0} />
            ))}
            {/* On this route there is no catalogue to link back to, so the
                closing cell points at the thing a catalogue is for. */}
            {products.length % 3 !== 0 && (
              <ProductsMore href="/contact" label="Start a project" note="Fixed scope, fixed price." />
            )}
          </div>
        ) : (
          <div class="pointer">
            <p class="pointer__body">
              Nothing published yet. The products behind this site are listed as soon as there is
              something worth showing.
            </p>
          </div>
        )
      }
    </div>
  </section>

  {
    differentiators.length > 0 && (
      <Section
        id="differentiators"
        eyebrow="How this studio works"
        title="Six things that are true here."
        note="Not a list of virtues. Each one is a practice you can hold us to."
      >
        <dl class="statements">
          {differentiators.map((item) => (
            <div class="statement" data-reveal>
              <dt class="statement__label">{item.label}</dt>
              <dd class="statement__body">{item.body}</dd>
            </div>
          ))}
        </dl>
      </Section>
    )
  }

  <Section eyebrow="Next" title="Something else in mind?">
    <p class="lede-para">
      Products are what we build for ourselves. If you have a problem of your own, that is what
      <a href="/services">Services</a> is for.
    </p>
    <p>
      <a class="btn" href="/services">
        See what we do
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </p>
  </Section>
</Base>
