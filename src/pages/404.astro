---
import Base from '~/layouts/Base.astro';
import NotFound from '~/components/NotFound.astro';
import { studio } from '~/config/site';
import { getEnv, hasDb } from '~/lib/env';
import { listOwnProducts, readFallback } from '~/lib/db';

export const prerender = true;

const env = await getEnv();
let recent: Awaited<ReturnType<typeof listOwnProducts>> = [];
if (hasDb(env)) {
  recent = await listOwnProducts(env.DB as never).catch(
    readFallback('404.products', [] as typeof recent),
  );
}
---

<Base
  title={`Page not found — ${studio.name}`}
  description="That page does not exist."
  canonicalPath="/404"
>
  {/* The standard shape: `main > section > .shell`, not the reverse. Inverted,
      this page's section was not a `main > section` at all, so it sat outside
      the surface system entirely. The surface itself stays the paper one on
      purpose: `NotFound` is shared with the slug 404s, which render inside a
      case section on paper, and the two are meant to be the same page. */}
  <section class="section section--lg">
    <div class="shell">
      <NotFound recent={recent} />
    </div>
  </section>
</Base>
