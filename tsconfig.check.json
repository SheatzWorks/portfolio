{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "astro/client"],
    "paths": {
      "~/*": ["./src/*"],
      "astro:middleware": ["./.astro/types.d.ts"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*.ts", "src/**/*.astro", "tests/**/*.ts"]
}
